      ['skep review <task_id> --allow-command', 'Approve and remember a pending shell command, then resume the run.'],
      ['skep review <task_id> --reverify', 'Re-verify a completed run that was never re-verified, with the project\'s pinned verify command. A run with no re-verification record cannot be approved.'],
