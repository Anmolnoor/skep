        ['--quiet', 'Do not print the live phase lines.'],
      ],
    },
  },
  {
    id: 'review',
    eyebrow: 'Review and land',
    title: 'Read the evidence, then decide',
    lead: 'Approving a completed run applies its patch on a branch. The branch, pull-request and repository commands are your half of git: they run on your own credentials.',
    rows: [
      ['skep review <task_id>', 'The run\'s evidence, re-verification result, approval state and diff. A unique prefix of the id is enough.'],
      ['skep review <task_id> --approve [--branch NAME] [--pr] [--pr-base BRANCH] [--note TEXT] [--actor NAME]', 'On a completed run, apply the patch on <code>skep/&lt;task_id&gt;</code> or the branch you name; the default branch is refused. On a run waiting at a gate, resume it. <code>--pr</code> then pushes that branch and opens a pull request with the GitHub CLI.'],
