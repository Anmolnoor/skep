---
// CLI: the command surface, grouped by what a person is trying to do. Every
// synopsis was read from `skep <command> --help` under a throwaway home.
// tests/supervisor/test_site_facts.py holds each `skep <command> [<subcommand>]`
// named here against the argparse surface. The slash deck is not typed: it is
// read at build from the web app's own COMMANDS table.
import Base from '../layouts/Base.astro';
import Callout from '../components/Callout.astro';
import Chip from '../components/Chip.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Section from '../components/Section.astro';
import Table from '../components/Table.astro';
import Terminal from '../components/Terminal.astro';
import { readRepoFile, siteFacts } from '../lib/repo.mjs';

const { version, contract } = siteFacts();

// Captured: `skep --version`. The two numbers are the build-time values.
const versionOut = `
$ skep --version
skep ${version} (worker contract ${contract})
`;

// ---- the slash deck, from the code ----
const appJs = readRepoFile('src/skep/supervisor/serve/static/app.js');
const deckSource = /const COMMANDS = \{\n([\s\S]*?)\n\};/.exec(appJs)?.[1];
if (!deckSource) throw new Error('app.js: the COMMANDS table was not found');
// The table is a plain object literal of strings in this repository's own file.
const DECK: Record<string, { usage: string; desc: string }> = new Function(`return {${deckSource}}`)();
const CARD = ' (confirm card)';
// src/skep/cli_chat.py: /trust and /steer act at once; /btw is a read-only model turn.
const AT_ONCE = new Set(['trust', 'steer']);
const effects = {
  card: { kind: 'ask', label: 'confirm card' },
  'at once': { kind: 'limit', label: 'acts at once' },
  'model turn': { kind: 'ok', label: 'read-only turn' },
  read: { kind: 'ok', label: 'read' },
} as const;
const effectOf = (name: string, desc: string): keyof typeof effects =>
  desc.includes(CARD) ? 'card' : AT_ONCE.has(name) ? 'at once' : name === 'btw' ? 'model turn' : 'read';
const deck = Object.entries(DECK).map(([name, { usage, desc }]) => ({
  usage,
  desc: desc.replace(CARD, ''),
  effect: effects[effectOf(name, desc)],
}));

// The five commands that exist only in the terminal (usage from src/skep/cli_chat.py COMMANDS).
const terminalOnly = [
  ['/status', 'Print the startup line again: assistant readiness, approvals and cards waiting.'],
  ['/model [name] [--scope chat|default]', 'Show the model this chat uses. With a name, propose a change of model on a card.'],
  ['/replay', 'Print the last messages of this chat.'],
  ['/stop', 'Stop this chat\'s running turn at its next step. The web chat has a Stop button on its working line.'],
  ['/exit', 'Leave the chat. A bare exit or quit also works.'],
];
const cliOnly = /CLI_ONLY = frozenset\(\{([^}]*)\}\)/.exec(readRepoFile('src/skep/cli_chat.py'))?.[1];
const cliOnlyNames = (cliOnly?.match(/[a-z]+/g) ?? []).sort().join(' ');
if (cliOnlyNames !== 'exit model replay status stop') {
  throw new Error(`cli_chat.py CLI_ONLY is now "${cliOnlyNames}": update terminalOnly in cli.astro`);
}

// ---- the commands ----
type Row = [command: string, what: string];
interface Group {
  id: string;
  eyebrow: string;
  title: string;
  lead: string;
  rows: Row[];
  options?: { caption: string; rows: Row[] };
  note?: string;
}

const groups: Group[] = [
  {
    id: 'setup',
