    rows: [
      ['skep onboard [--provider NAME] [--model MODEL] [--endpoint URL] [--api-key-env ENV] [--workdir DIR] [--sandbox auto|podman|none] [--template NAME] [--role NAME] [--yes] [--no-chat]', 'The guided first run: model, work directory, sandbox, policy baseline, role. Run it again and it resumes at the first step that is not done.'],
      ['skep onboard --check', 'Read-only: <code>skep doctor</code> plus the baseline, engine, sandbox, work directory and egress checks. Exits 0 only when all are ready.'],
      ['skep onboard --quiet | --verbose', 'Turn the first-session <code>why:</code> lines and the per-turn tally off, or back on.'],
      ['skep setup --personal [--provider NAME] [--model MODEL] [--endpoint URL] [--api-key-env ENV]', 'Create or update the local profile without the guided steps.'],
      ['skep setup --template NAME [--dry-run] [--apply]', 'Apply a policy template (builder, operator, assistant). <code>--dry-run</code> prints the resolved table and writes nothing; <code>--apply</code> confirms switching an existing policy document.'],
      ['skep doctor', 'Check configuration and runtime readiness: profile, provider, each engine and its sign-in, the sandbox. Exits non-zero when the profile is not ready.'],
      ['skep status [--personal] [--json]', 'Setup, provider, sandbox and approval status. <code>--personal</code> adds recent runs with their re-verification state.'],
      ['skep provider list', 'Registered model providers.'],
      ['skep provider health', 'The latest health probe of each provider.'],
      ['skep provider presets', 'The built-in catalog. Each row says where prompts go.'],
      ['skep provider add [ID] [--preset PRESET] [--protocol P] [--base-url URL] [--model M] [--api-key-env ENV] [--cost-class C] [--order N] [--host H] [--activate]', 'Register a provider profile, from a preset or by protocol (anthropic, bedrock, ollama, openai_compat, openai_responses). <code>--api-key-env</code> takes the name of a variable, never a key.'],
      ['skep provider use ID', 'Make a profile the active one. The assistant uses it from its next turn.'],
      ['skep provider set-key ID [--clear]', 'Store a profile\'s API key. The value is read from standard input and kept in a 0600 file.'],
      ['skep provider login ID --client-id CID [--device-url URL] [--token-url URL] [--scope S]', 'OAuth device-code login with your own client id; the token is stored as the key.'],
      ['skep provider remove ID', 'Delete a provider profile.'],
    ],
  },
  {
    id: 'run',
    eyebrow: 'Run a task',
    title: 'Dispatch work',
    lead: 'One task against one repository, a small team of tasks, and a view of the agents running on this machine.',
    rows: [
