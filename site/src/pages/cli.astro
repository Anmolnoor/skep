      ['skep team --manager ROLE --task REPO INSTRUCTIONS [--task …] [--role ROLE] [--delegated-by ACTOR@ROLE] [--execution-mode sandbox|workspace] [--answer-host HOST] [--worker-cmd COMMAND]', 'A team run: a manager in a role dispatches one to three tasks, recorded as one thread in the decision log.'],
      ['skep agents [--json]', 'Coding agents running on this machine, each working, idle or blocked, and whether skep governs it.'],
    ],
    options: {
      caption: 'Options of skep run',
      rows: [
        ['--execution-mode sandbox|workspace', '<code>sandbox</code> runs the worker behind the OS sandbox. <code>workspace</code> has no OS sandbox and is for skep\'s own worker only. An external engine always runs in <code>sandbox</code>.'],
        ['--engine aider|builtin|claude_code|codex|pi', 'The coding engine for this run, over the project\'s pinned engine.'],
        ['--worker-cmd COMMAND', 'A worker command for this run (default: <code>$SKEP_WORKER_CMD</code>, else skep\'s own worker). A project pinned to an external engine refuses it unless <code>--engine builtin</code> is passed.'],
        ['--network DOMAIN', 'A domain the worker may reach; repeatable; added to the project\'s hosts. Omitted, the policy\'s default network applies: the builder and operator baselines allow their package registries, the assistant baseline and a bare home allow none. A worker that calls the model always reaches its configured provider.'],
        ['--minimal', 'Start with deny-all grants and learn through approvals. A worker that calls the model still reaches its provider. Cannot be combined with <code>--template</code>, <code>--network</code> or <code>--env-allow</code>.'],
