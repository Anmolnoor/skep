---
// Icon: a Lucide icon rendered to inline SVG at build (no client JS), plus the
// two marks Lucide does not ship: `github` and `skep` (the hexagon).
// Names are Lucide's kebab-case names: https://lucide.dev/icons
import * as lucide from '@lucide/astro';

interface Props {
  name: string;
  size?: number;
  /** Accessible name. Without it the icon is decorative (aria-hidden). */
  label?: string;
  class?: string;
}

const { name, size = 16, label, class: className } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' as const };
const pascal = name.replace(/(^|-)([a-z0-9])/g, (_, __, char: string) => char.toUpperCase());
const Lucide = (lucide as Record<string, any>)[pascal];
if (name !== 'github' && name !== 'skep' && typeof Lucide !== 'function') {
  throw new Error(`Icon: no Lucide icon named "${name}" (see https://lucide.dev/icons)`);
}
---

{
  name === 'skep' ? (
    <svg width={size} height={size} viewBox="0 0 32 32" fill="none" class={className} {...a11y}>
      <path d="M16 1.6 29.2 9.2v15.2L16 32 2.8 24.4V9.2L16 1.6Z" fill="#FF6B1F" />
      <path
        d="M16 9.4 22.6 13.2v7.6L16 24.6 9.4 20.8v-7.6L16 9.4Z"
        stroke="#0A0B0C"
        stroke-width="1.8"
        fill="none"
      />
    </svg>
  ) : name === 'github' ? (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} {...a11y}>
      <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.1c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
    </svg>
  ) : (
    <Lucide size={size} class={className} {...a11y} />
  )
}
