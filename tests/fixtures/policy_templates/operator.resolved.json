{
  "rules": {
    "browse": [
      {
        "verdict": "require_approval",
        "rule_id": "browse-read-gated",
        "action": "read",
        "pattern": "*"
      },
      {
        "verdict": "require_approval",
        "rule_id": "browse-act-gated",
        "action": "act",
        "pattern": "*"
      }
    ],
    "coding": [
      {
        "verdict": "allow",
        "rule_id": "coding-workspace",
        "action": "edit",
        "pattern": "workspace"
      },
      {
        "verdict": "allow",
        "rule_id": "verify-workspace",
        "action": "verify",
        "pattern": "workspace"
      }
    ],
    "email": [
      {
        "verdict": "require_approval",
        "rule_id": "email-read-gated",
        "action": "read",
        "pattern": "*"
      },
      {
        "verdict": "require_approval",
        "rule_id": "email-send-gated",
        "action": "send",
        "pattern": "*"
      }
    ],
    "filesystem": [
      {
        "verdict": "allow",
        "rule_id": "fs-workspace",
        "action": "write",
        "pattern": "workspace"
      },
      {
        "verdict": "require_approval",
        "rule_id": "fs-write-gated",
        "action": "write",
        "pattern": "*"
      }
    ],
    "mcp": [
      {
        "verdict": "require_approval",
        "rule_id": "mcp-gated",
        "action": "call",
        "pattern": "*"
      }
    ],
    "network": [
      {
        "verdict": "allow",
        "rule_id": "net-pypi",
        "action": "connect",
        "pattern": "pypi.org"
      },
      {
        "verdict": "allow",
        "rule_id": "net-pythonhosted",
        "action": "connect",
        "pattern": "files.pythonhosted.org"
      },
      {
        "verdict": "allow",
        "rule_id": "net-npm",
        "action": "connect",
        "pattern": "registry.npmjs.org"
      },
      {
        "verdict": "allow",
        "rule_id": "net-go",
        "action": "connect",
        "pattern": "proxy.golang.org"
      },
      {
        "verdict": "allow",
        "rule_id": "net-search",
        "action": "search",
        "pattern": "*"
      },
      {
        "verdict": "allow",
        "rule_id": "net-fetch-github",
        "action": "fetch",
        "pattern": "github.com"
      },
      {
        "verdict": "allow",
        "rule_id": "net-fetch-github-api",
        "action": "fetch",
        "pattern": "api.github.com"
      },
      {
        "verdict": "require_approval",
        "rule_id": "net-gated",
        "action": "connect",
        "pattern": "*"
      },
      {
        "verdict": "require_approval",
        "rule_id": "net-fetch-gated",
        "action": "fetch",
        "pattern": "*"
      }
    ],
    "shell": [
      {
        "verdict": "allow",
        "rule_id": "shell-git-status",
        "action": "run",
        "pattern": "git status"
      },
      {
        "verdict": "allow",
        "rule_id": "shell-git-diff",
        "action": "run",
        "pattern": "git diff"
      },
      {
        "verdict": "allow",
        "rule_id": "shell-git-log",
        "action": "run",
        "pattern": "git log"
      },
      {
        "verdict": "allow",
        "rule_id": "shell-df",
        "action": "run",
        "pattern": "df"
      },
      {
        "verdict": "allow",
        "rule_id": "shell-du",
        "action": "run",
        "pattern": "du"
      },
      {
        "verdict": "allow",
        "rule_id": "shell-uptime",
        "action": "run",
        "pattern": "uptime"
      },
      {
        "verdict": "require_approval",
        "rule_id": "shell-gated",
        "action": "run",
        "pattern": "*"
      }
    ]
  },
  "settings": {
    "default_network": [
      "pypi.org",
      "files.pythonhosted.org",
      "registry.npmjs.org",
      "proxy.golang.org"
    ],
    "allowed_shell_commands": [
      [
        "git",
        "status"
      ],
      [
        "git",
        "diff"
      ],
      [
        "git",
        "log"
      ],
      [
        "df"
      ],
      [
        "du"
      ],
      [
        "uptime"
      ]
    ]
  }
}
