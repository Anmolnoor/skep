{
  "template": "homelab-ops",
  "pack": "trusted_local_ops",
  "scopes": [
    {
      "scope": "coding",
      "require_approval": [
        {"rule_id": "coding-gated", "action": "edit", "pattern": "*"},
        {"rule_id": "verify-gated", "action": "verify", "pattern": "*"}
      ]
    },
    {
      "scope": "shell",
      "allow": [
        {"rule_id": "shell-journalctl", "action": "run", "pattern": "journalctl"},
        {"rule_id": "shell-systemctl-status", "action": "run", "pattern": "systemctl status"},
        {"rule_id": "shell-df", "action": "run", "pattern": "df"},
        {"rule_id": "shell-du", "action": "run", "pattern": "du"}
      ],
      "require_approval": [
        {"rule_id": "shell-gated", "action": "run", "pattern": "*"}
      ]
    },
    {
      "scope": "filesystem",
      "allow": [
        {"rule_id": "fs-read", "action": "read", "pattern": "*"},
        {"rule_id": "fs-var-log", "action": "write", "pattern": "/var/log/*"},
        {"rule_id": "fs-ops-tmp", "action": "write", "pattern": "/tmp/ops/*"}
      ],
      "require_approval": [
        {"rule_id": "fs-write-gated", "action": "write", "pattern": "*"}
      ]
    },
    {
      "scope": "network",
      "require_approval": [
        {"rule_id": "net-gated", "action": "connect", "pattern": "*"}
      ]
    },
    {
      "scope": "mcp",
      "require_approval": [
        {"rule_id": "mcp-gated", "action": "call", "pattern": "*"}
      ]
    },
    {
      "scope": "email",
      "require_approval": [
        {"rule_id": "email-read-gated", "action": "read", "pattern": "*"},
        {"rule_id": "email-send-gated", "action": "send", "pattern": "*"}
      ]
    }
  ],
  "learned": []
}
