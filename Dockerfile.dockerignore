# BuildKit per-Dockerfile ignore. The build context is this skep checkout.
.git
.venv
# Dev state carries secrets (llm-secret, serve-token) — never bake it in.
.skep-dev*
.uv-cache
__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
.DS_Store
dist
build
*.egg-info
output
node_modules
plans
plan
.claude
# The docs site is not part of the image: it is built and deployed by the site
# workflow, and its React Bits copies (site/src/components/reactbits) must not be
# redistributed. This also keeps site/node_modules, site/dist and site/.astro out.
site
